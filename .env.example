# ============================================================================
#  InvoChain configuration.  Copy to  .env  (repo root) and fill in.
#  EVERYTHING HERE IS FREE. Never put a key from a wallet that holds real money.
# ============================================================================

# ---------- Backend ----------------------------------------------------------
# Long random strings. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ENCRYPTION_MASTER_KEY=change-me-32+chars-secret-for-wrapping-keys

# MongoDB: local Docker (docker compose up -d), Atlas free tier URI, or "mock" (in-memory, not saved)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=invochain

# Wallets that become ADMIN on first sign-in (comma separated). Use the DEPLOYER wallet:
# only the contract admin can clear flagged invoices on-chain.
ADMIN_WALLETS=0xYourAdminWalletAddress

# ---------- Blockchain -------------------------------------------------------
# Local dev:  RPC_URL=http://127.0.0.1:8545  CHAIN_ID=31337
# Sepolia:    RPC_URL=https://sepolia.infura.io/v3/<key>  (or Alchemy / a free public RPC)  CHAIN_ID=11155111
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# "Operator" = a dedicated TESTNET-ONLY wallet used by the backend to record AI risk tiers and sync roles.
# It can NOT verify, finance or repay invoices. Fund it with a little free Sepolia ETH.
OPERATOR_PRIVATE_KEY=
OPERATOR_ADDRESS=

# Used only by `npx hardhat run scripts/deploy.js --network sepolia`
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# 0 = off. e.g. 60 re-checks open invoices against the chain every minute (view calls only, free-RPC friendly)
RECONCILE_INTERVAL_SECONDS=0

# ---------- AI (optional, free tier) ----------------------------------------
# Get a free key at https://aistudio.google.com/apikey . Without it everything still works with built-in rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_ENABLED=true

# ---------- Documents / IPFS -------------------------------------------------
# mock   = nothing leaves your machine (default, zero setup)
# pinata = free plan; create a JWT at https://app.pinata.cloud/developers/api-keys
# local  = your own IPFS node (Kubo) at IPFS_API_URL
IPFS_MODE=mock
PINATA_JWT=
IPFS_API_URL=http://127.0.0.1:5001

# ---------- Frontend (frontend/.env) ----------------------------------------
# VITE_API_PROXY=http://127.0.0.1:8000
